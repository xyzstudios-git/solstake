# Optional server configuration. npm start loads .env when present.
# Copy this file to .env and keep that file private.
SOLSTAKE_PORT=8790
SOLSTAKE_RPC_URL=https://api.mainnet-beta.solana.com

# Replace SOLSTAKE_RPC_URL with your provider endpoint when needed.
# Put provider credentials only in .env or your server environment.
# Previous SOLFUND_PORT / SOLFUND_RPC_URL and legacy LEERGUT_PORT / LEERGUT_RPC_URL remain supported.
# LEERGUT_PORT=8790
# LEERGUT_RPC_URL=https://api.mainnet-beta.solana.com
#
# Optional local demo ports, exported before running npm run demo:
# DEMO_APP_PORT=8791
# DEMO_CHAIN_PORT=8899
